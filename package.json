{
  "name": "codar-bot",
  "version": "0.0.2",
  "bin": {
    "codar": "bin/codar.cjs"
  },
  "description": "A home for your bot team on the pi runtime — self-hosted, bring-your-own-model, chat-style multi-bot collaboration with budgets, approvals, and an audit trail.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codarwang/codar-bot.git"
  },
  "homepage": "https://codarbot.com",
  "keywords": [
    "pi",
    "agent",
    "multi-agent",
    "bot-team",
    "self-hosted",
    "orchestration"
  ],
  "files": [
    "bin/codar.cjs",
    "dist/web/",
    "dist/host/",
    "dist/driver/",
    "extensions/codar-gate/",
    "compose/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx --test --test-timeout=120000 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "host": "tsx src/host/cli.ts",
    "host:fake": "CODAR_PI_BIN=node CODAR_PI_ARGV=$(pwd)/tests/fixtures/fake-pi.mjs CODAR_BOT_HOME=$(pwd)/.fake-home tsx src/host/cli.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:deploy": "npm --prefix web run build && mkdir -p \"${CODAR_BOT_HOME:-$HOME/.codar-bot}/web-dist\" && cp -r web/dist/* \"${CODAR_BOT_HOME:-$HOME/.codar-bot}/web-dist/\"",
    "build": "npm run web:build && tsc -p tsconfig.build.json && rm -rf dist/web && cp -r web/dist dist/web"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "private": false,
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0"
  },
  "engines": {
    "node": ">=22.19"
  }
}
